DEBUG=false

# Optional API key required by llm-bot itself for incoming requests.
API_KEY=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODE=chat_completions
LLM_TIMEOUT=120
LLM_REASONING_PROFILE=none
LLM_REASONING_EFFORT=
LLM_STRIP_REASONING_OUTPUT=true
LLM_PARSE_REASONING_AS_OUTPUT=false

# Optional independent decisions service for cybersecurity classification.
# Full endpoint URL, e.g. https://openrouter.ai/api/alpha/decisions.
# Leave empty to retain the existing generative LLM classification.
DECISIONS_URL=
DECISIONS_API_KEY=
DECISIONS_MODEL=
# systemone: OpenRouter, llama.cpp, vLLM /v1/systemone; openai: /v1/decisions.
DECISIONS_API_MODE=systemone
DECISIONS_TIMEOUT=120

LOOKUP_BASE_URL=
LOOKUP_API_KEY=
LOOKUP_DEFAULT_LANGUAGE=en
LOOKUP_CANDIDATE_LIMIT=5
NER_LINKING_ENABLED=false
NER_LINKING_MODE=llm

SUMMARY_MAX_INPUT_CHARS=50000
SUMMARY_MAX_OUTPUT_CHARS=1000
SUMMARY_ROUTE_PATH=/summarize
NER_ROUTE_PATH=/ner
NER_ENTITY_TYPES=PER,ORG,GPE,PRODUCT,EVENT,GROUP,MALWARE,TOOL,TACTIC,TECHNIQUE,SECTOR,INDICATOR
# Maximum summary characters sent to the model per story when clustering.
CLUSTER_MAX_CONTENT_CHARS_PER_STORY=800
CLUSTER_MAX_TAGS_PER_STORY=10
